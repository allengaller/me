---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="qa-page" id="app">
    <div class="qa-page-header">
      <p class="qa-eyebrow">Self-Distillation</p>
      <h1 class="qa-title">Distill how <em>you</em> think.</h1>
      <p class="qa-desc">12 questions about your thinking. Walk away with a SKILL.md -- your cognitive operating system, ready for Claude Code.</p>
    </div>

    <div class="qa-split">
      <aside class="preview-col" id="previewCol">
        <div class="preview-top">
          <span class="preview-label">SKILL.md</span>
          <div class="preview-actions">
            <button class="btn-icon" id="resetBtn" title="Start over">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            </button>
            <button class="btn-icon" id="exportBtn" title="Export">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </button>
          </div>
        </div>
        <div class="preview-scroll" id="previewContent">
          <div class="preview-empty">Your SKILL.md will take shape here as you answer...</div>
        </div>
      </aside>

      <main class="qa-col">
        <div class="qa-progress">
          <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
          </div>
          <span class="progress-text" id="progressText">1 / 12</span>
        </div>

        <div class="qa-body" id="qaBody">
          <div class="qa-chapter" id="qaChapter"></div>
          <h2 class="qa-question" id="qaQuestion"></h2>
          <p class="qa-hint" id="qaHint"></p>
          <textarea class="qa-input" id="qaInput" rows="5" placeholder=""></textarea>
          <p class="qa-shortcut" id="qaShortcut"></p>
        </div>

        <div class="qa-nav">
          <button class="btn btn-secondary" id="prevBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Previous
          </button>
          <button class="btn btn-primary" id="nextBtn">
            Next
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </main>
    </div>

    <div class="modal" id="exportModal" style="display:none;">
      <div class="modal-backdrop" id="modalBackdrop"></div>
      <div class="modal-body">
        <div class="modal-header">
          <h3>Export SKILL.md</h3>
          <button class="btn-icon" id="modalClose">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="modal-hint">
          Save as <code>.claude/skills/me-perspective/SKILL.md</code> to use with Claude Code.
          <a href="https://github.com/alchaincyf/nuwa-skill" target="_blank" rel="noopener">Learn about Nuwa skills</a>
        </div>
        <div class="modal-warn" id="modalWarn" style="display:none;">
          You have not answered any questions yet. The export will be mostly empty.
        </div>
        <textarea class="modal-area" id="exportArea" readonly rows="20"></textarea>
        <div class="modal-actions">
          <button class="btn btn-primary" id="copyBtn">Copy to clipboard</button>
          <button class="btn btn-secondary" id="downloadBtn">Download SKILL.md</button>
        </div>
      </div>
    </div>

    <div class="modal" id="resetModal" style="display:none;">
      <div class="modal-backdrop" id="resetBackdrop"></div>
      <div class="modal-body" style="max-width:440px;">
        <div class="modal-header">
          <h3>Start over?</h3>
          <button class="btn-icon" id="resetClose">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="modal-prompt">
          This will clear all your answers and progress. This cannot be undone.
        </div>
        <div class="modal-actions">
          <button class="btn btn-secondary" id="resetCancel">Cancel</button>
          <button class="btn btn-danger" id="resetConfirm">Clear everything</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import '../scripts/distill-engine';
</script>

<style>
  .qa-page { min-height: calc(100vh - 56px); }

  .qa-page-header {
    text-align: center;
    padding: 2.5rem 2rem 0;
    max-width: 580px;
    margin: 0 auto;
  }

  .qa-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .qa-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .qa-title em { color: var(--accent); }

  .qa-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .qa-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 56px - 180px);
    border-top: 1px solid var(--border-subtle);
  }

  .preview-col {
    background: var(--bg-raised);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .preview-top {
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .preview-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .preview-actions { display: flex; gap: 0.5rem; }

  .btn-icon {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    transition: color var(--transition);
    display: flex;
  }
  .btn-icon:hover { color: var(--text); }

  .preview-scroll {
    flex: 1;
    padding: 2rem 1.5rem;
    overflow-y: auto;
  }

  .preview-empty {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .pv-chapter {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .pv-chapter:first-child { margin-top: 0; }

  .pv-paragraph {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }

  .qa-col {
    display: flex;
    flex-direction: column;
    padding: 2rem 3rem;
  }

  .qa-progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .progress-bar {
    flex: 1;
    height: 2px;
    background: var(--border);
    border-radius: 1px;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 1px;
    transition: width 0.4s ease;
  }

  .progress-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .qa-body { flex: 1; }

  .qa-chapter {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .qa-question {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .qa-hint {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .qa-input {
    width: 100%;
    min-height: 140px;
    font-size: 0.92rem;
    line-height: 1.7;
    resize: vertical;
    padding: 0.9rem 1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    transition: border-color var(--transition);
    outline: none;
  }
  .qa-input:focus { border-color: var(--accent-border); }
  .qa-input::placeholder { color: var(--text-muted); font-style: italic; }

  .qa-shortcut {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    opacity: 0.7;
  }

  .qa-nav {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    margin-top: auto;
  }

  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
  }

  .modal-body {
    position: relative;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    width: 90%;
    max-width: 640px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .modal-header h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .modal-hint {
    padding: 0.75rem 1.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
    line-height: 1.5;
  }

  .modal-hint code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    color: var(--text-secondary);
  }

  .modal-hint a {
    color: var(--accent);
    display: inline-block;
    margin-left: 0.5rem;
  }

  .modal-warn {
    padding: 0.75rem 1.5rem;
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--accent-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .modal-area {
    flex: 1;
    padding: 1.5rem;
    background: var(--bg);
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    resize: none;
    outline: none;
  }

  .modal-prompt {
    padding: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .modal-actions {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .btn-danger {
    background: var(--red);
    color: #fff;
  }
  .btn-danger:hover { opacity: 0.9; color: #fff; }

  @media (max-width: 768px) {
    .qa-split {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .preview-col {
      border-right: none;
      border-bottom: 1px solid var(--border);
      max-height: 35vh;
    }
    .qa-col { padding: 1.5rem; }
    .qa-question { font-size: 1.25rem; }
  }
</style>
