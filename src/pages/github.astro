---
import Layout from '../layouts/Layout.astro';

const GITHUB_EMAIL = 'allengaller@gmail.com';

// GitHub API configuration
const GITHUB_API = 'https://api.github.com';

// Helper function to get language color
function getLanguageColor(language) {
  const colors = {
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Python': '#3572A5',
    'Java': '#b07219',
    'Go': '#00ADD8',
    'Rust': '#dea584',
    'C++': '#f34b7d',
    'C': '#555555',
    'C#': '#239120',
    'PHP': '#4F5D95',
    'Ruby': '#701516',
    'Swift': '#F05138',
    'Kotlin': '#A97BFF',
    'Dart': '#00B4AB',
    'HTML': '#e34c26',
    'CSS': '#563d7c',
    'Shell': '#89e051',
    'Vue': '#41b883',
    'Astro': '#FF5D01',
  };
  return colors[language] || '#8b949e';
}

// Helper function to format date
function formatDate(dateString) {
  const date = new Date(dateString);
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));

  if (days === 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 7) return `${days} days ago`;
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  if (days < 365) return `${Math.floor(days / 30)} months ago`;
  return `${Math.floor(days / 365)} years ago`;
}

async function fetchGitHubData() {
  try {
    // First, get user profile from email (requires authenticated request or search)
    // Since we can't use search API easily, we'll try to get user info from known endpoints
    // For now, we'll need to use the username or create a mechanism to get it

    // Step 1: Get user info (we need to find the username from email)
    // Using search API which requires authentication for most uses
    const searchResponse = await fetch(
      `${GITHUB_API}/search/users?q=${encodeURIComponent(GITHUB_EMAIL)}`
    );
    const searchData = await searchResponse.json();

    if (!searchData.items || searchData.items.length === 0) {
      return { error: 'User not found' };
    }

    const username = searchData.items[0].login;

    // Step 2: Get user profile
    const userResponse = await fetch(`${GITHUB_API}/users/${username}`);
    const user = await userResponse.json();

    // Step 3: Get user repositories
    const reposResponse = await fetch(`${GITHUB_API}/users/${username}/repos?sort=updated&per_page=100`);
    const repos = await reposResponse.json();

    // Step 4: Get user organizations
    const orgsResponse = await fetch(`${GITHUB_API}/user/${username}/orgs`);
    const orgs = await orgsResponse.json();

    // Step 5: Get repositories for each organization
    const orgReposMap = new Map();
    if (Array.isArray(orgs)) {
      for (const org of orgs) {
        const orgReposResponse = await fetch(`${GITHUB_API}/orgs/${org.login}/repos?sort=updated&per_page=100`);
        const orgRepos = await orgReposResponse.json();
        orgReposMap.set(org.login, {
          org,
          repos: Array.isArray(orgRepos) ? orgRepos : []
        });
      }
    }

    return {
      user,
      username,
      repos: Array.isArray(repos) ? repos : [],
      orgs: Array.isArray(orgs) ? orgs : [],
      orgReposMap,
      error: null
    };
  } catch (error) {
    console.error('Error fetching GitHub data:', error);
    return {
      error: error.message,
      user: null,
      username: null,
      repos: [],
      orgs: [],
      orgReposMap: new Map()
    };
  }
}

const githubData = await fetchGitHubData();
---

<Layout>
  <main>
    <!-- Language Switcher -->
    <button id="lang-switcher" class="lang-switcher" onclick="window.setLanguage()">
      🌐 EN
    </button>

    <section class="github-section">
      <div class="container">
        <!-- Back to Home -->
        <div class="back-link">
          <a href="/">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span data-i18n data-en="Back to Home" data-zh="返回首页">Back to Home</span>
          </a>
        </div>

        <h1 class="page-title" data-i18n data-en="GitHub Profile" data-zh="GitHub 资料库">GitHub Profile</h1>

        {githubData.error ? (
          <div class="error-message">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 8v4M12 16h.01"></path>
            </svg>
            <h3 data-i18n data-en="Unable to load GitHub data" data-zh="无法加载 GitHub 数据">Unable to load GitHub data</h3>
            <p>{githubData.error}</p>
          </div>
        ) : (
          <>
            <!-- User Profile Card -->
            {githubData.user && (
              <div class="profile-card">
                <div class="profile-avatar">
                  <img src={githubData.user.avatar_url} alt={githubData.user.name || githubData.user.login} />
                  <div class="profile-badges">
                    {githubData.user.type === 'User' && (
                      <span class="badge badge-user" data-i18n data-en="User" data-zh="用户">User</span>
                    )}
                    {githubData.user.site_admin && (
                      <span class="badge badge-admin" data-i18n data-en="Staff" data-zh="员工">Staff</span>
                    )}
                  </div>
                </div>
                <div class="profile-info">
                  <h2 class="profile-name">
                    {githubData.user.name || githubData.user.login}
                  </h2>
                  <p class="profile-login">@{githubData.user.login}</p>
                  {githubData.user.bio && (
                    <p class="profile-bio" data-i18n data-en={githubData.user.bio} data-zh={githubData.user.bio}>
                      {githubData.user.bio}
                    </p>
                  )}
                  <div class="profile-stats">
                    <div class="stat-item">
                      <div class="stat-value">{githubData.user.public_repos || 0}</div>
                      <div class="stat-label" data-i18n data-en="Repositories" data-zh="仓库">Repositories</div>
                    </div>
                    <div class="stat-item">
                      <div class="stat-value">{githubData.user.followers || 0}</div>
                      <div class="stat-label" data-i18n data-en="Followers" data-zh="关注者">Followers</div>
                    </div>
                    <div class="stat-item">
                      <div class="stat-value">{githubData.user.following || 0}</div>
                      <div class="stat-label" data-i18n data-en="Following" data-zh="关注中">Following</div>
                    </div>
                    <div class="stat-item">
                      <div class="stat-value">{githubData.orgs.length || 0}</div>
                      <div class="stat-label" data-i18n data-en="Organizations" data-zh="组织">Organizations</div>
                    </div>
                  </div>
                  <div class="profile-meta">
                    {githubData.user.location && (
                      <div class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                          <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>{githubData.user.location}</span>
                      </div>
                    )}
                    {githubData.user.company && (
                      <div class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                        <span>{githubData.user.company}</span>
                      </div>
                    )}
                    {githubData.user.blog && (
                      <div class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                        <a href={githubData.user.blog.startsWith('http') ? githubData.user.blog : `https://${githubData.user.blog}`} target="_blank" rel="noopener noreferrer">
                          {githubData.user.blog}
                        </a>
                      </div>
                    )}
                    {githubData.user.created_at && (
                      <div class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span data-i18n data-en={`Joined ${new Date(githubData.user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}`} data-zh={`加入于 ${new Date(githubData.user.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}`}>
                          {`Joined ${new Date(githubData.user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}`}
                        </span>
                      </div>
                    )}
                  </div>
                  <div class="profile-links">
                    <a href={githubData.user.html_url} target="_blank" rel="noopener noreferrer" class="btn primary">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                      <span data-i18n data-en="View on GitHub" data-zh="在 GitHub 上查看">View on GitHub</span>
                    </a>
                  </div>
                </div>
              </div>
            )}

            <!-- Personal Repositories -->
            {githubData.repos.length > 0 && (
              <div class="repos-section">
                <div class="section-header">
                  <h2 class="section-title" data-i18n data-en="Personal Repositories" data-zh="个人仓库">Personal Repositories</h2>
                  <div class="repo-count">
                    <span class="count-badge">{githubData.repos.length}</span>
                  </div>
                </div>
                <div class="repos-grid">
                  {githubData.repos.map(repo => (
                    <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="repo-card">
                      <div class="repo-header">
                        <div class="repo-icon">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                          </svg>
                        </div>
                        <div class="repo-name">{repo.name}</div>
                        <div class="repo-visibility">
                          {repo.private ? (
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                          ) : (
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                              <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                          )}
                        </div>
                      </div>
                      {repo.description && (
                        <p class="repo-description">{repo.description}</p>
                      )}
                      <div class="repo-meta">
                        <div class="repo-language">
                          {repo.language && (
                            <>
                              <span class="language-dot" style={`background-color: ${getLanguageColor(repo.language)}`}></span>
                              <span>{repo.language}</span>
                            </>
                          )}
                        </div>
                        <div class="repo-stats">
                          <span class="stat" title="Stars">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>
                            {repo.stargazers_count}
                          </span>
                          <span class="stat" title="Forks">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <line x1="6" y1="3" x2="6" y2="15"></line>
                              <circle cx="18" cy="6" r="3"></circle>
                              <circle cx="6" cy="18" r="3"></circle>
                              <path d="M18 9a9 9 0 0 1-9 9"></path>
                            </svg>
                            {repo.forks_count}
                          </span>
                          {repo.updated_at && (
                            <span class="stat updated" title="Last updated">
                              {formatDate(repo.updated_at)}
                            </span>
                          )}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Organizations -->
            {githubData.orgs.length > 0 && (
              <div class="orgs-section">
                <div class="section-header">
                  <h2 class="section-title" data-i18n data-en="Organizations" data-zh="组织">Organizations</h2>
                  <div class="repo-count">
                    <span class="count-badge">{githubData.orgs.length}</span>
                  </div>
                </div>
                <div class="orgs-grid">
                  {githubData.orgs.map(org => {
                    const orgData = githubData.orgReposMap.get(org.login);
                    const orgRepos = orgData?.repos || [];
                    return (
                      <div class="org-card" id={`org-${org.login}`}>
                        <div class="org-header">
                          <img src={org.avatar_url} alt={org.login} class="org-avatar" />
                          <div class="org-info">
                            <h3 class="org-name">{org.login}</h3>
                            {org.description && (
                              <p class="org-description">{org.description}</p>
                            )}
                          </div>
                          <a href={org.html_url} target="_blank" rel="noopener noreferrer" class="btn-link">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                              <polyline points="15 3 21 3 21 9"></polyline>
                              <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                          </a>
                        </div>
                        {orgRepos.length > 0 && (
                          <div class="org-repos">
                            <div class="org-repos-header">
                              <span data-i18n data-en="Repositories" data-zh="仓库">Repositories</span>
                              <span class="count-badge small">{orgRepos.length}</span>
                            </div>
                            <div class="org-repos-list">
                              {orgRepos.map(repo => (
                                <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="org-repo-item">
                                  <div class="repo-name-small">{repo.name}</div>
                                  <div class="repo-stats-mini">
                                    {repo.language && <span class="language-tag">{repo.language}</span>}
                                    <span class="stars">⭐ {repo.stargazers_count}</span>
                                  </div>
                                </a>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            <!-- Loading indicator -->
            {!githubData.user && !githubData.error && (
              <div class="loading-state">
                <div class="spinner"></div>
                <p data-i18n data-en="Loading GitHub data..." data-zh="正在加载 GitHub 数据...">Loading GitHub data...</p>
              </div>
            )}
          </>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .github-section {
    padding: 2rem 1rem 6rem;
    min-height: 100vh;
  }

  .back-link {
    margin-bottom: 2rem;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .back-link a:hover {
    color: var(--accent);
    transform: translateX(-4px);
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .profile-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 3rem;
    margin-bottom: 4rem;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  .profile-avatar {
    position: relative;
  }

  .profile-avatar img {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 4px solid var(--accent);
    box-shadow: 0 0 40px var(--accent-glow);
    object-fit: cover;
  }

  .profile-badges {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-user {
    background: var(--accent);
    color: white;
  }

  .badge-admin {
    background: var(--accent-secondary);
    color: white;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .profile-name {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0;
  }

  .profile-login {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .profile-bio {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .profile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .meta-item svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .meta-item a {
    color: var(--accent);
  }

  .profile-links {
    margin-top: 1.5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0;
  }

  .repo-count {
    display: flex;
    gap: 0.5rem;
  }

  .count-badge {
    padding: 0.375rem 0.875rem;
    background: var(--accent);
    color: white;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .count-badge.small {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }

  .repos-section,
  .orgs-section {
    margin-bottom: 4rem;
  }

  .repos-grid,
  .orgs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  .repo-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
    display: block;
  }

  .repo-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }

  .repo-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .repo-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .repo-name {
    flex: 1;
    font-weight: 600;
    color: var(--accent);
    font-size: 1.125rem;
  }

  .repo-visibility {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .repo-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .repo-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .repo-language {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .language-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .repo-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .repo-stats .stat {
    display: flex;
    align-items: center;
    gap: 0.25rem;
