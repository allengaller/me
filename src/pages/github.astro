---
import Layout from '../layouts/Layout.astro';
import config from '../config/profile.json';

const profile = config.profile;
const { social, projects } = config;
const GITHUB_EMAIL = 'allengaller@gmail.com';
const GITHUB_API = 'https://api.github.com';

// Extract GitHub URL from social links
const githubSocial = social.find(s => s.platform === 'GitHub');
const githubUsername = githubSocial?.url?.replace('https://github.com/', '') || '';
---

<Layout>
  <div class="gh-page">
    <div class="gh-mode-toggle">
      <button class="mode-btn active" data-mode="api">Live API</button>
      <button class="mode-btn" data-mode="static">From Profile</button>
    </div>

    <div class="gh-intro">
      <p class="gh-eyebrow">GitHub</p>
      <h1 class="gh-title">Your GitHub <em>presence.</em></h1>
    </div>

    <div id="gh-content" class="gh-content">
      <!-- Content will be loaded based on mode -->
    </div>
  </div>

  <script>
    const GITHUB_EMAIL = 'allengaller@gmail.com';
    const GITHUB_API = 'https://api.github.com';
    const profile = { name: 'Your Name', about: '', location: '' };
    const projects = [];
    const githubUsername = '';

    const content = document.getElementById('gh-content');
    let currentMode = 'api';

    function getLanguageColor(language) {
      const colors = {
        'JavaScript': '#f1e05a', 'TypeScript': '#3178c6', 'Python': '#3572A5',
        'Java': '#b07219', 'Go': '#00ADD8', 'Rust': '#dea584',
        'C++': '#f34b7d', 'C': '#555555', 'C#': '#239120',
        'PHP': '#4F5D95', 'Ruby': '#701516', 'Swift': '#F05138',
        'Kotlin': '#A97BFF', 'Dart': '#00B4AB', 'HTML': '#e34c26',
        'CSS': '#563d7c', 'Shell': '#89e051', 'Vue': '#41b883', 'Astro': '#FF5D01',
      };
      return colors[language] || '#8b949e';
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const days = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
      if (days === 0) return 'today';
      if (days === 1) return 'yesterday';
      if (days < 7) return `${days} days ago`;
      if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
      if (days < 365) return `${Math.floor(days / 30)} months ago`;
      return `${Math.floor(days / 365)} years ago`;
    }

    // Static mode - render from profile.json
    function renderStatic() {
      const githubProjects = projects.filter(p => p.github?.includes('github.com'));
      content.innerHTML = `
        <div class="gh-profile">
          <div class="gh-avatar-placeholder">
            <span>${profile.name.split(' ').map(n => n[0]).join('').toUpperCase()}</span>
          </div>
          <div class="gh-profile-info">
            <h2>${profile.name}</h2>
            <span class="gh-login">@${githubUsername || 'username'}</span>
            <p class="gh-bio">${profile.about || 'No bio available'}</p>
            <div class="gh-meta">
              ${profile.location ? `<span class="gh-meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${profile.location}</span>` : ''}
            </div>
            <a href="https://github.com/${githubUsername}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">View on GitHub</a>
          </div>
        </div>
        ${githubProjects.length > 0 ? `
          <div class="gh-section">
            <div class="gh-section-head">
              <h2>Repositories</h2>
              <span class="gh-badge">${githubProjects.length}</span>
            </div>
            <div class="gh-repos">
              ${githubProjects.map(repo => `
                <a href="${repo.github}" target="_blank" rel="noopener noreferrer" class="gh-repo">
                  <div class="gh-repo-head">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span class="gh-repo-name">${repo.github.split('/').pop()}</span>
                  </div>
                  <p class="gh-repo-desc">${repo.description || 'No description'}</p>
                  <div class="gh-repo-meta">
                    ${repo.technologies.slice(0, 2).map(t => `<span class="gh-repo-lang"><span class="gh-lang-dot" style="background:${getLanguageColor(t)}"></span>${t}</span>`).join('')}
                  </div>
                </a>
              `).join('')}
            </div>
          </div>
        ` : ''}
      `;
    }

    // API mode - fetch live data
    async function renderAPI() {
      try {
        const searchResponse = await fetch(`${GITHUB_API}/search/users?q=${encodeURIComponent(GITHUB_EMAIL)}`);
        const searchData = await searchResponse.json();
        if (!searchData.items || searchData.items.length === 0) {
          content.innerHTML = '<div class="gh-empty"><p>User not found</p></div>';
          return;
        }

        const username = searchData.items[0].login;
        const userResponse = await fetch(`${GITHUB_API}/users/${username}`);
        const user = await userResponse.json();

        const reposResponse = await fetch(`${GITHUB_API}/users/${username}/repos?sort=updated&per_page=100`);
        const repos = await reposResponse.json();

        content.innerHTML = `
          <div class="gh-profile">
            <img src="${user.avatar_url}" alt="${user.name || user.login}" class="gh-avatar" />
            <div class="gh-profile-info">
              <h2>${user.name || user.login}</h2>
              <span class="gh-login">@${user.login}</span>
              ${user.bio ? `<p class="gh-bio">${user.bio}</p>` : ''}
              <div class="gh-stats">
                <div class="gh-stat"><strong>${user.public_repos || 0}</strong><span>Repos</span></div>
                <div class="gh-stat"><strong>${user.followers || 0}</strong><span>Followers</span></div>
                <div class="gh-stat"><strong>${user.following || 0}</strong><span>Following</span></div>
              </div>
              <div class="gh-meta">
                ${user.location ? `<span class="gh-meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${user.location}</span>` : ''}
                ${user.company ? `<span class="gh-meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>${user.company}</span>` : ''}
              </div>
              <a href="${user.html_url}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">View on GitHub</a>
            </div>
          </div>
          ${repos.length > 0 ? `
            <div class="gh-section">
              <div class="gh-section-head">
                <h2>Repositories</h2>
                <span class="gh-badge">${repos.length}</span>
              </div>
              <div class="gh-repos">
                ${repos.slice(0, 20).map(repo => `
                  <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer" class="gh-repo">
                    <div class="gh-repo-head">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                      <span class="gh-repo-name">${repo.name}</span>
                    </div>
                    ${repo.description ? `<p class="gh-repo-desc">${repo.description}</p>` : ''}
                    <div class="gh-repo-meta">
                      ${repo.language ? `<span class="gh-repo-lang"><span class="gh-lang-dot" style="background:${getLanguageColor(repo.language)}"></span>${repo.language}</span>` : ''}
                      <span class="gh-repo-stat"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>${repo.stargazers_count}</span>
                      <span class="gh-repo-date">${formatDate(repo.updated_at)}</span>
                    </div>
                  </a>
                `).join('')}
              </div>
            </div>
          ` : ''}
        `;
      } catch (error) {
        content.innerHTML = `<div class="gh-empty"><p>Error loading GitHub data: ${error.message}</p></div>`;
      }
    }

    // Mode toggle handlers
    document.querySelectorAll('.mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentMode = btn.dataset.mode;
        if (currentMode === 'static') {
          renderStatic();
        } else {
          renderAPI();
        }
      });
    });

    // Initial render
    renderAPI();
  </script>

<style>
  .gh-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  .gh-intro {
    text-align: center;
    margin-bottom: 3rem;
  }

  .gh-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .gh-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text);
  }
  .gh-title em { color: var(--accent); }

  .gh-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-secondary);
  }
  .gh-empty svg { margin: 0 auto 1rem; color: var(--text-muted); }
  .gh-empty h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .gh-profile {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-bottom: 3rem;
  }

  .gh-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid var(--border);
    object-fit: cover;
    flex-shrink: 0;
  }

  .gh-profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .gh-profile-info h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .gh-login {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .gh-bio {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .gh-stats {
    display: flex;
    gap: 2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin: 0.5rem 0;
  }

  .gh-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }
  .gh-stat strong {
    font-size: 1.25rem;
    color: var(--text);
  }
  .gh-stat span {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .gh-meta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .gh-meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .gh-meta-item svg { color: var(--text-muted); flex-shrink: 0; }

  .gh-section {
    margin-bottom: 3rem;
  }

  .gh-section-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .gh-section-head h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .gh-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-muted);
  }

  .gh-repos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .gh-repo {
    background: var(--bg);
    padding: 1.25rem 1.5rem;
    color: var(--text);
    text-decoration: none;
    transition: background var(--transition);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .gh-repo:hover { background: var(--bg-raised); color: var(--text); }

  .gh-repo-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .gh-repo-name {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--accent);
  }

  .gh-repo-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gh-repo-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: auto;
  }

  .gh-repo-lang {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .gh-lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .gh-repo-stat {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .gh-orgs {
    display: grid;
    gap: 1rem;
  }

  .gh-org {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .gh-org-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .gh-org-head h3 {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .gh-org-head p {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .gh-org-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .gh-org-head .btn-icon { margin-left: auto; }

  .gh-org-repos {
    display: flex;
    flex-direction: column;
    gap: 0.5px;
    background: var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .gh-org-repo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
    font-size: 0.82rem;
    transition: background var(--transition);
  }
  .gh-org-repo:hover { background: var(--bg-raised); color: var(--text); }

  .gh-lang-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
  }

  .gh-loading {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-secondary);
  }

  .gh-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .btn-icon {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    transition: color var(--transition);
    display: flex;
  }
  .btn-icon:hover { color: var(--text); }

  .gh-mode-toggle {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    justify-content: center;
  }

  .mode-btn {
    padding: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition);
  }

  .mode-btn:hover {
    border-color: var(--text-muted);
    color: var(--text);
  }

  .mode-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .gh-avatar-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--accent-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gh-avatar-placeholder span {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--accent);
  }

  .gh-content {
    min-height: 400px;
  }

  @media (max-width: 768px) {
    .gh-profile {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2rem;
    }
    .gh-stats { justify-content: center; }
    .gh-meta { justify-content: center; }
    .gh-repos { grid-template-columns: 1fr; }
  }
</style>
