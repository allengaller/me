---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="preview-page">
    <div class="preview-intro">
      <p class="preview-eyebrow">Live Preview</p>
      <h1>See your profile in action.</h1>
      <p>A real-time render of your saved data. Complete the wizard first, then come back.</p>
    </div>

    <div class="preview-frame-wrapper">
      <div class="device-frame">
        <div class="device-bar">
          <div class="device-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="device-title">localhost:4321</span>
          <span class="device-nav">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
          </span>
        </div>
        <iframe id="preview-iframe" src="/" frameborder="0"></iframe>
      </div>
    </div>

    <div class="preview-note">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <span>This preview uses your saved data. Nothing is sent to a server.</span>
    </div>
  </div>
</Layout>

<script>
  import { loadDraft } from '../utils/storage';

  const draft = loadDraft();
  const iframe = document.getElementById('preview-iframe');

  if (!draft) {
    iframe.srcdoc = `<!doctype html><html><head><style>
      body { background: #0b0b0b; color: #78716c; font-family: 'DM Sans', system-ui, sans-serif;
        display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;
        text-align: center; padding: 2rem; }
      h2 { color: #d6d3d1; font-family: 'Crimson Pro', Georgia, serif; font-weight: 400;
        font-style: italic; font-size: 1.5rem; margin-bottom: 0.5rem; }
      p { line-height: 1.6; font-size: 0.9rem; }
    </style></head><body>
      <div><h2>No data yet</h2><p>Complete the wizard first, then come back to preview.</p></div>
    </body></html>`;
  }
</script>

<style>
  .preview-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  .preview-intro {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .preview-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .preview-intro h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .preview-intro p {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .preview-frame-wrapper {
    margin-bottom: 2rem;
  }

  .device-frame {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .device-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    background: var(--bg-overlay);
    border-bottom: 1px solid var(--border);
  }

  .device-dots {
    display: flex;
    gap: 6px;
  }

  .device-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }
  .device-dots span:nth-child(1) { background: #5a3a3a; }
  .device-dots span:nth-child(2) { background: #4a4a2e; }
  .device-dots span:nth-child(3) { background: #2e4a2e; }

  .device-title {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-align: center;
  }

  .device-nav {
    display: flex;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .device-frame iframe {
    width: 100%;
    height: 560px;
    background: var(--bg);
    display: block;
  }

  .preview-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .device-frame iframe { height: 380px; }
    .device-title { display: none; }
  }
</style>
