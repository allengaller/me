---
import Layout from '../layouts/Layout.astro';
import config from '../config/profile.json';
const { profile, skills, projects } = config;
---

<Layout>
  <section class="hero">
    <div class="hero-content">
      <div class="hero-tag">
        <span class="tag-line"></span>
        <span class="tag-text">Personal Archive</span>
      </div>
      <h1 class="hero-title">
        Build your<br />
        <em>digital identity.</em>
      </h1>
      <p class="hero-body">
        Skill trees, autobiographies, and SOUL.md profiles &mdash; 
        crafted through guided conversations, not forms.
      </p>
      <div class="hero-actions">
        <a href="/wizard" class="btn btn-primary btn-large">Start building</a>
        <a href="#features" class="btn btn-secondary btn-large">Learn more</a>
      </div>
    </div>
    <div class="hero-aside" aria-hidden="true">
      <div class="aside-card">
        <div class="card-label">skills</div>
        <div class="card-tree">
          <span class="branch">Backend</span>
          <span class="branch">Frontend</span>
          <span class="branch">DevOps</span>
        </div>
        <div class="card-bar">
          <span class="bar-fill"></span>
        </div>
      </div>
      <div class="aside-card aside-card--offset">
        <div class="card-label">autobiography</div>
        <div class="card-lines">
          <span class="line"></span>
          <span class="line" style="width: 80%"></span>
          <span class="line" style="width: 55%"></span>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="features">
    <div class="features-inner">
      <div class="features-label">Capabilities</div>
      <div class="feature-grid">
        <a href="/wizard" class="feature-block">
          <div class="feature-num">01</div>
          <h2>Skill Tree</h2>
          <p>Visualize your expertise as a living tree. Track progress on every technology, add notes, watch it grow.</p>
        </a>
        <a href="/autobiography" class="feature-block">
          <div class="feature-num">02</div>
          <h2>Autobiography</h2>
          <p>Answer thoughtful questions one by one. Watch your life story take shape in real time, chapter by chapter.</p>
        </a>
        <a href="/distill" class="feature-block">
          <div class="feature-num">03</div>
          <h2>Self-Distillation</h2>
          <p>Extract your cognitive operating system &mdash; mental models, decision rules, expression DNA &mdash; into a SKILL.md for Claude Code.</p>
        </a>
        <a href="/wizard" class="feature-block">
          <div class="feature-num">04</div>
          <h2>SOUL.md</h2>
          <p>Generate a portable personal profile. Export as Markdown, JSON, or YAML &mdash; take it anywhere.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="how">
    <div class="how-inner">
      <h2 class="section-heading">How it works</h2>
      <ol class="how-steps">
        <li>
          <strong>Answer questions</strong>
          <span>Guided prompts, not blank forms. One question at a time.</span>
        </li>
        <li>
          <strong>See it build</strong>
          <span>Live preview updates as you type. Your profile grows with every answer.</span>
        </li>
        <li>
          <strong>Export anywhere</strong>
          <span>SOUL.md, JSON, YAML. Your data, your choice. Nothing leaves your browser.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="cta">
    <div class="cta-inner">
      <div class="cta-rule"></div>
      <p class="cta-eyebrow">No sign-up required</p>
      <h2>Your story starts here.</h2>
      <a href="/wizard" class="btn btn-primary btn-large">Get started</a>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand">ME<span class="brand-dot">.</span></span>
      <span class="footer-note">Built for the community. All data stays in your browser.</span>
    </div>
  </footer>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    padding: 5rem 2rem;
    max-width: 1080px;
    margin: 0 auto;
    gap: 5rem;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-tag {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .tag-line {
    width: 24px;
    height: 1px;
    background: var(--accent);
  }

  .tag-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.5vw, 4rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-body {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 440px;
    line-height: 1.75;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 260px;
    flex-shrink: 0;
  }

  .aside-card {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    transition: border-color 0.4s ease, transform 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .aside-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent-dim) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .aside-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .aside-card:hover::before {
    opacity: 1;
  }

  .aside-card--offset {
    margin-left: 3rem;
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    position: relative;
  }

  .card-tree {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    position: relative;
  }

  .branch {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .card-bar {
    height: 3px;
    background: var(--bg-overlay);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .bar-fill {
    display: block;
    height: 100%;
    width: 82%;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-hover) 100%);
    border-radius: 2px;
    animation: bar-grow 1.5s var(--ease-out) forwards;
  }

  @keyframes bar-grow {
    from { width: 0; }
    to { width: 82%; }
  }

  .card-lines {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    position: relative;
  }

  .line {
    display: block;
    height: 5px;
    width: 100%;
    background: var(--bg-overlay);
    border-radius: 3px;
  }

  .features {
    border-top: 1px solid var(--border-subtle);
    padding: 6rem 2rem;
  }

  .features-inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .features-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .feature-block {
    background: var(--bg);
    padding: 2.5rem 2rem;
    color: var(--text);
    text-decoration: none;
    transition: background 0.3s ease;
    position: relative;
  }

  .feature-block:hover {
    background: var(--bg-raised);
    color: var(--text);
  }

  .feature-block::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }

  .feature-block:hover::after {
    transform: scaleX(1);
  }

  .feature-num {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--accent);
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
  }

  .feature-block h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }

  .feature-block p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.7;
    font-weight: 300;
  }

  .how {
    border-top: 1px solid var(--border-subtle);
    padding: 6rem 2rem;
  }

  .how-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    margin-bottom: 3rem;
    color: var(--text);
    letter-spacing: 0.01em;
  }

  .how-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    counter-reset: step;
  }

  .how-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 3rem;
    position: relative;
  }

  .how-steps li::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .how-steps li strong {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.01em;
  }

  .how-steps li span {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.65;
    font-weight: 300;
  }

  .cta {
    border-top: 1px solid var(--border-subtle);
    padding: 8rem 2rem;
  }

  .cta-inner {
    max-width: 440px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-rule {
    width: 32px;
    height: 1px;
    background: var(--accent);
    margin: 0 auto 2rem;
  }

  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .cta h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 400;
    font-style: italic;
    color: var(--accent);
    margin-bottom: 2rem;
    letter-spacing: 0.01em;
  }

  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: 2rem;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-secondary);
    letter-spacing: 0.06em;
  }

  .brand-dot { color: var(--text-muted); }

  .footer-note {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      min-height: auto;
      padding: 4rem 1.5rem 3rem;
      gap: 2.5rem;
    }

    .hero-aside {
      width: 100%;
      flex-direction: row;
    }

    .aside-card--offset { margin-left: 0; }
    .aside-card { flex: 1; }
    .feature-grid { grid-template-columns: 1fr; }

    .footer-inner {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
