---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/homepage/HeroSection.astro';
import StatsCounter from '../components/homepage/StatsCounter.astro';
import ProjectShowcase from '../components/homepage/ProjectShowcase.astro';
import ExperienceTimeline from '../components/homepage/ExperienceTimeline.astro';
import SkillTree from '../components/homepage/SkillTree.astro';
import SocialLinks from '../components/homepage/SocialLinks.astro';

import config from '../config/profile.json';
const { profile, skills, projects, experience, social } = config;

// Calculate stats
const yearsExp = experience.length > 0
  ? Math.max(...experience.map((exp: any) => {
      const match = exp.period.match(/\d{4}/g);
      if (match && match.length >= 2) {
        return parseInt(match[1]) - parseInt(match[0]);
      }
      return 2;
    }))
  : 5;

const stats = [
  { value: yearsExp, label: 'Years Experience' },
  { value: projects.length, label: 'Projects' },
  { value: skills.length, label: 'Skills' }
];
---

<Layout>
  <HeroSection
    name={profile.name}
    title={profile.title}
    location={profile.location}
    about={profile.about}
    avatar={profile.avatar}
  />

  <StatsCounter stats={stats} />

  <ProjectShowcase projects={projects} />

  <ExperienceTimeline experiences={experience} />

  <SkillTree skills={skills} />

  <SocialLinks social={social} />
</Layout>