---
import Layout from '../layouts/Layout.astro';
import config from '../config/profile.json';

const { profile, social, skills, projects, experience } = config;
---

<Layout>
  <main>
    <!-- ME Tool Hero Section -->
    <section class="tool-hero">
      <div class="tool-content">
        <div class="tool-badge">🚀 开源工具</div>
        <h1 class="tool-title">
          <span class="gradient-text">ME</span>
          <span class="subtitle">个人档案生成器</span>
        </h1>
        <p class="tool-description">
          通过友好的分步引导，创建属于您的 <strong>SOUL.md</strong> 个人档案。
          <br>
          支持跨平台导入导出，让信息在龙虾社区等平台间自由流动。
        </p>
        <div class="tool-actions">
          <a href="/wizard" class="btn btn-primary btn-large">
            开始创建
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
          <a href="#preview" class="btn btn-secondary btn-large">
            查看示例
          </a>
        </div>
        
        <div class="tool-features">
          <div class="feature-tag">
            <span>✨</span>
            分步引导
          </div>
          <div class="feature-tag">
            <span>💾</span>
            自动保存
          </div>
          <div class="feature-tag">
            <span>🦞</span>
            社区集成
          </div>
          <div class="feature-tag">
            <span>📦</span>
            多格式导出
          </div>
        </div>
      </div>
      
      <div class="hero-bg">
        <div class="gradient-orb orb-1"></div>
        <div class="gradient-orb orb-2"></div>
        <div class="gradient-orb orb-3"></div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
      <div class="container">
        <h2 class="section-title">为什么选择 ME?</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🎯</div>
            <h3>分步引导</h3>
            <p>6 步简单操作，从基础信息到社区集成，引导您创建完整的个人档案</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🔄</div>
            <h3>跨平台导入</h3>
            <p>支持从 GitHub 等平台一键导入，自动填充您的公开资料</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🦞</div>
            <h3>龙虾社区</h3>
            <p>专为龙虾社区优化，轻松配置跨平台 ID，实现信息快速同步</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📄</div>
            <h3>SOUL.md</h3>
            <p>生成标准化的 SOUL.md 文件，成为您在开源世界的数字名片</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>本地存储</h3>
            <p>所有数据保存在您的浏览器本地，无需上传服务器，隐私更安全</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🎨</div>
            <h3>精美主页</h3>
            <p>自动生成美观的个人主页，支持响应式设计，完美展示您的档案</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Workflow Section -->
    <section class="workflow-section">
      <div class="container">
        <h2 class="section-title">使用流程</h2>
        <div class="workflow-steps">
          <div class="workflow-step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>填写信息</h3>
              <p>通过 6 步向导填写您的个人信息、技能、项目和经历</p>
            </div>
          </div>
          <div class="workflow-arrow">→</div>
          <div class="workflow-step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>实时预览</h3>
              <p>随时查看生成的个人主页效果，确保展示最佳形象</p>
            </div>
          </div>
          <div class="workflow-arrow">→</div>
          <div class="workflow-step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>导出使用</h3>
              <p>下载 SOUL.md、JSON 或 YAML 格式，用于各平台展示</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Preview Section -->
    <section id="preview" class="preview-section">
      <div class="container">
        <h2 class="section-title">示例展示</h2>
        <p class="section-subtitle">以下是使用 ME 工具生成的个人主页示例</p>
        
        <!-- Original Profile Content -->
        <div class="profile-preview">
          <!-- Hero -->
          <div class="preview-hero">
            <div class="avatar">
              {profile.avatar ? (
                <img src={profile.avatar} alt={profile.name} />
              ) : (
                <div class="avatar-placeholder">
                  <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </div>
              )}
            </div>
            <h2 class="preview-name">{profile.name}</h2>
            <p class="preview-title">{profile.title}</p>
            <p class="preview-location">📍 {profile.location}</p>
            <p class="preview-about">{profile.about}</p>
          </div>
          
          <!-- Skills Preview -->
          <div class="preview-skills">
            <h3>技能专长</h3>
            <div class="skills-tags">
              {skills.slice(0, 3).map(skill => (
                skill.technologies.slice(0, 3).map(tech => (
                  <span class="skill-tag">{tech}</span>
                ))
              ))}
            </div>
          </div>
          
          <!-- Projects Preview -->
          <div class="preview-projects">
            <h3>精选项目</h3>
            <div class="projects-list">
              {projects.slice(0, 2).map(project => (
                <div class="project-mini">
                  <h4>{project.title}</h4>
                  <p>{project.description.substring(0, 80)}...</p>
                  <div class="project-tech">
                    {project.technologies.slice(0, 3).map(tech => (
                      <span>{tech}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <div class="preview-cta">
          <a href="/wizard" class="btn btn-primary">
            创建我的档案
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>准备好创建您的档案了吗?</h2>
          <p>完全免费，无需注册，数据本地存储</p>
          <a href="/wizard" class="btn btn-primary btn-large">
            立即开始
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-brand">
            <span class="brand-logo">ME</span>
            <span>个人档案生成器</span>
          </div>
          <div class="footer-links">
            <a href="/wizard">开始使用</a>
            <a href="https://github.com" target="_blank">GitHub</a>
            <a href="/preview">预览示例</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>Made with ❤️ for the community</p>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Tool Hero Section */
  .tool-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem 4rem;
    overflow: hidden;
  }
  
  .tool-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
  }
  
  .tool-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 100px;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
  
  .tool-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  
  .gradient-text {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 900;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  
  .subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--text-secondary);
  }
  
  .tool-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.8;
  }
  
  .tool-description strong {
    color: var(--accent);
  }
  
  .tool-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }
  
  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.125rem;
  }
  
  .btn-primary {
    background: var(--accent);
    color: white;
    box-shadow: 0 4px 16px var(--accent-glow);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }
  
  .btn-secondary {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }
  
  .btn-secondary:hover {
    border-color: var(--accent);
    background: var(--bg-secondary);
  }
  
  .tool-features {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .feature-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  
  .feature-tag span {
    font-size: 1rem;
  }
  
  /* Hero Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    animation: float 8s ease-in-out infinite;
  }
  
  .orb-1 {
    width: 400px;
    height: 400px;
    background: var(--gradient-1);
    top: -100px;
    right: -100px;
    animation-delay: 0s;
  }
  
  .orb-2 {
    width: 300px;
    height: 300px;
    background: var(--gradient-2);
    bottom: -50px;
    left: -50px;
    animation-delay: 2s;
  }
  
  .orb-3 {
    width: 250px;
    height: 250px;
    background: var(--gradient-3);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: 4s;
  }
  
  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(30px, -30px) scale(1.1);
    }
  }
  
  /* Features Section */
  .features-section {
    padding: 6rem 2rem;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .feature-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }
  
  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }
  
  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  
  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  
  .feature-card p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  
  /* Workflow Section */
  .workflow-section {
    padding: 6rem 2rem;
  }
  
  .workflow-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  
  .workflow-step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 280px;
  }
  
  .step-number {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-secondary) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
  }
  
  .step-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .step-content p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  
  .workflow-arrow {
    font-size: 2rem;
    color: var(--accent);
    opacity: 0.5;
  }
  
  /* Preview Section */
  .preview-section {
    padding: 6rem 2rem;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }
  
  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 3rem;
    font-size: 1.125rem;
  }
  
  .profile-preview {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2rem;
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  
  .preview-hero {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  
  .avatar {
    margin-bottom: 1rem;
  }
  
  .avatar img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    box-shadow: 0 0 20px var(--accent-glow);
    object-fit: cover;
  }
  
  .avatar-placeholder {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    background: var(--bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    color: var(--text-muted);
  }
  
  .preview-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  
  .preview-title {
    font-size: 1rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  
  .preview-location {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  
  .preview-about {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  
  .preview-skills {
    margin-bottom: 2rem;
  }
  
  .preview-skills h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  
  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .skill-tag {
    padding: 0.375rem 0.875rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  
  .preview-projects h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .project-mini {
    padding: 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  
  .project-mini h4 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .project-mini p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }
  
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  
  .project-tech span {
    padding: 0.25rem 0.5rem;
    background: var(--bg-tertiary);
    border-radius: 4px;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
  
  .preview-cta {
    text-align: center;
  }
  
  /* CTA Section */
  .cta-section {
    padding: 6rem 2rem;
  }
  
  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .cta-content h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  
  .cta-content p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  
  /* Footer */
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: 3rem 2rem;
  }
  
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  
  .brand-logo {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-secondary) 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.25rem;
  }
  
  .footer-links {
    display: flex;
    gap: 2rem;
  }
  
  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .footer-links a:hover {
    color: var(--accent);
  }
  
  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  
  .footer-bottom p {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .workflow-steps {
      flex-direction: column;
      gap: 1.5rem;
    }
    
    .workflow-arrow {
      transform: rotate(90deg);
    }
    
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
    
    .footer-links {
      gap: 1rem;
    }
  }
</style>
