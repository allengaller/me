---
import Layout from '../../layouts/Layout.astro';
import SoulExport from '../../components/export/SoulExport.astro';
---

<Layout>
  <div class="done-page">
    <div class="done-container">
      <div class="done-mark">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      </div>

      <h1>Profile complete</h1>
      <p class="done-sub">Your personal profile is ready to export.</p>

      <div class="done-stats">
        <div class="done-stat">
          <span class="done-val" id="profile-name">-</span>
          <span class="done-lbl">Name</span>
        </div>
        <div class="done-stat">
          <span class="done-val" id="skills-count">0</span>
          <span class="done-lbl">Skills</span>
        </div>
        <div class="done-stat">
          <span class="done-val" id="projects-count">0</span>
          <span class="done-lbl">Projects</span>
        </div>
        <div class="done-stat">
          <span class="done-val" id="exp-count">0</span>
          <span class="done-lbl">Experience</span>
        </div>
      </div>

      <div class="done-exports">
        <h2>Export your profile</h2>
        <p>Choose a format and download.</p>

        <div class="done-grid">
          <SoulExport />

          <div class="done-card">
            <div class="done-card-head">
              <div class="done-icon json-icon">{ }</div>
              <div>
                <h3>JSON</h3>
                <p>Structured data for programmatic use</p>
              </div>
            </div>
            <button id="download-json" class="btn btn-secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download profile.json
            </button>
          </div>

          <div class="done-card">
            <div class="done-card-head">
              <div class="done-icon yaml-icon">YML</div>
              <div>
                <h3>YAML</h3>
                <p>Human-friendly serialization format</p>
              </div>
            </div>
            <button id="download-yaml" class="btn btn-secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download profile.yaml
            </button>
          </div>
        </div>
      </div>

      <div class="done-actions">
        <a href="/preview" target="_blank" class="btn btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          Preview profile
        </a>
        <a href="/wizard" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          Back to start
        </a>
      </div>

      <div class="done-reset">
        <button id="reset-btn" class="done-reset-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Clear data and start over
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { loadDraft, clearDraft } from '../../utils/storage.js';
  import { downloadJson } from '../../utils/exporters/json.js';
  import { downloadYaml } from '../../utils/exporters/yaml.js';

  const draft = loadDraft();

  if (draft) {
    document.getElementById('profile-name').textContent = draft.profile?.name || '-';
    document.getElementById('skills-count').textContent = draft.skills?.length || 0;
    document.getElementById('projects-count').textContent = draft.projects?.length || 0;
    document.getElementById('exp-count').textContent = draft.experience?.length || 0;
  }

  document.getElementById('download-json').addEventListener('click', () => {
    if (draft) { downloadJson(draft); } else { alert('No data available'); }
  });

  document.getElementById('download-yaml').addEventListener('click', () => {
    if (draft) { downloadYaml(draft); } else { alert('No data available'); }
  });

  document.getElementById('reset-btn').addEventListener('click', () => {
    if (confirm('Clear all data? This cannot be undone.')) {
      clearDraft();
      window.location.href = '/wizard';
    }
  });
</script>

<style>
  .done-page {
    min-height: calc(100vh - 56px);
    padding: 4rem 2rem;
  }

  .done-container {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .done-mark {
    width: 48px;
    height: 48px;
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin: 0 auto 1.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  .done-sub {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-bottom: 2.5rem;
  }

  .done-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .done-stat {
    background: var(--bg);
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .done-val {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text);
  }

  .done-lbl {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .done-exports {
    margin-bottom: 3rem;
  }

  .done-exports h2 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .done-exports > p {
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-bottom: 1.5rem;
  }

  .done-grid {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .done-card {
    background: var(--bg);
    padding: 1.25rem 1.5rem;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .done-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .done-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.7rem;
  }

  .json-icon {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .yaml-icon {
    background: var(--accent-dim);
    color: var(--accent-hover);
    border: 1px solid var(--accent-border);
  }

  .done-card-head h3 {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .done-card-head p {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .done-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .done-reset {
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .done-reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: var(--font-body);
    cursor: pointer;
    transition: color var(--transition);
  }

  .done-reset-btn:hover {
    color: var(--red);
  }

  @media (max-width: 768px) {
    .done-stats { grid-template-columns: repeat(2, 1fr); }
    .done-card { flex-direction: column; align-items: flex-start; }
  }
</style>
