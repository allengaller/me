---
import Layout from '../../layouts/Layout.astro';
import ProgressBar from '../../components/wizard/ProgressBar.astro';
import FormField from '../../components/wizard/FormField.astro';
import WizardNav from '../../components/wizard/WizardNav.astro';
import GitHubImport from '../../components/import/GitHubImport.astro';
import FileImport from '../../components/import/FileImport.astro';

import '../../styles/wizard-shared.css';
---

<Layout>
  <main class="wizard-page">
    <div class="wizard-container">
      <ProgressBar currentStep={1} totalSteps={6} />
      
      <div class="step-header">
        <h1>Basic Info</h1>
        <p>Name, location, bio and avatar.</p>
      </div>
      
      <!-- 导入选项 (仅在 URL 参数包含 import 时显示) -->
      <div id="import-panel" class="import-panel" style="display: none;">
        <h3>Import existing data</h3>
        <div class="import-grid">
          <GitHubImport />
          <FileImport />
        </div>
      </div>
      
      <form id="step-1-form" class="step-form">
        <div class="form-section">
          <h3>Personal Info</h3>
          
          <FormField
            label="Name"
            name="name"
            placeholder="Your name"
            required
          />
          
          <FormField
            label="Title"
            name="title"
            placeholder="e.g. Senior Software Engineer"
            required
          />
          
          <FormField
            label="Location"
            name="location"
            placeholder="e.g. Shanghai, China"
            required
          />
          
          <FormField
            label="Bio"
            name="about"
            type="textarea"
            placeholder="A brief introduction..."
            rows={4}
            required
          />
          
          <FormField
            label="Avatar URL"
            name="avatar"
            type="url"
            placeholder="https://example.com/avatar.jpg"
            hint="Leave empty for default avatar"
          />
        </div>
        <button type="submit" style="display:none" id="submit-trigger"></button>
      </form>
      <WizardNav showPrev={false} nextUrl="/wizard/step-2" nextText="Next" />
    </div>
  </main>
</Layout>

<script>
  import { loadDraft, saveDraft } from '../../utils/storage';
  
  // 检查是否需要显示导入面板
  const urlParams = new URLSearchParams(window.location.search);
  const importType = urlParams.get('import');
  
  if (importType) {
    document.getElementById('import-panel').style.display = 'block';
  }
  
  // 加载草稿数据
  const draft = loadDraft();
  if (draft?.profile) {
    Object.keys(draft.profile).forEach(key => {
      const input = document.querySelector(`[name="${key}"]`);
      if (input && draft.profile[key]) {
        input.value = draft.profile[key];
      }
    });
  }
  
  // WizardNav next button
  document.querySelector('.wnav .btn-primary')?.addEventListener('click', () => {
    document.getElementById('step-1-form').requestSubmit();
  });

  // 表单提交
  document.getElementById('step-1-form').addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const profile = {
      name: formData.get('name'),
      title: formData.get('title'),
      location: formData.get('location'),
      about: formData.get('about'),
      avatar: formData.get('avatar')
    };
    
    // 合并到现有数据
    const existing = loadDraft() || {};
    existing.profile = { ...existing.profile, ...profile };
    
    saveDraft(existing);
    window.location.href = '/wizard/step-2';
  });
  
  // 自动保存
  document.querySelectorAll('input, textarea').forEach(input => {
    input.addEventListener('input', () => {
      const formData = new FormData(document.getElementById('step-1-form'));
      const profile = {
        name: formData.get('name'),
        title: formData.get('title'),
        location: formData.get('location'),
        about: formData.get('about'),
        avatar: formData.get('avatar')
      };
      
      const existing = loadDraft() || {};
      existing.profile = { ...existing.profile, ...profile };
      
      if (typeof window !== 'undefined' && window.debounceTimer) {
        clearTimeout(window.debounceTimer);
      }
      
      window.debounceTimer = setTimeout(() => {
        saveDraft(existing);
      }, 1000);
    });
  });
</script>

<style>
  @import '../../styles/wizard-shared.css';
  .wizard-page {
    min-height: calc(100vh - 56px);
    padding: 3rem 2rem 4rem;
  }

  .wizard-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .step-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .step-header h1 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .step-header p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .import-panel {
    margin-bottom: 2rem;
  }

  .import-panel h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .import-grid {
    display: grid;
    gap: 1rem;
  }

  .step-form {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .form-section h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }
</style>
