---
import Layout from '../../layouts/Layout.astro';
import ProgressBar from '../../components/wizard/ProgressBar.astro';
import FormField from '../../components/wizard/FormField.astro';
import WizardNav from '../../components/wizard/WizardNav.astro';
---

<Layout>
  <main class="wizard-page">
    <div class="wizard-container">
      <ProgressBar currentStep={6} totalSteps={6} />
      
      <div class="step-header">
        <h1>社区集成 & 完成</h1>
        <p>配置跨平台同步，完成您的档案创建</p>
      </div>
      
      <form id="step-6-form" class="step-form">
        <div class="form-section lobster-section">
          <div class="section-icon">🦞</div>
          <h3>龙虾社区</h3>
          <p class="section-desc">配置您在各个龙虾社区平台的 ID，便于快速导入预设信息</p>
          
          <div class="lobster-list" id="lobster-list">
            <!-- 动态生成 -->
          </div>
          
          <button type="button" class="btn btn-add" id="add-lobster">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            添加社区平台
          </button>
        </div>
        
        <div class="form-section">
          <h3>📋 档案预览</h3>
          <p class="section-desc">填写完成后，您可以在预览页面查看最终效果</p>
          
          <div class="preview-actions">
            <a href="/preview" target="_blank" class="btn btn-preview">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              在新窗口预览
            </a>
          </div>
        </div>
        
        <WizardNav 
          prevUrl="/wizard/step-5" 
          nextUrl="/wizard/complete" 
          nextText="完成创建" 
          isLast
        />
      </form>
    </div>
  </main>
</Layout>

<script>
  import { loadDraft, saveDraft } from '../../utils/storage.js';
  
  const lobsterList = document.getElementById('lobster-list');
  const addBtn = document.getElementById('add-lobster');
  
  const defaultPlatforms = ['龙虾社区', 'Lobsters', 'V2EX', 'GitHub'];
  
  function createLobsterItem(data = {}) {
    const div = document.createElement('div');
    div.className = 'lobster-item';
    div.innerHTML = `
      <select class="platform-select" name="platform">
        ${defaultPlatforms.map(p => `<option value="${p}" ${data.platform === p ? 'selected' : ''}>${p}</option>`).join('')}
        <option value="custom" ${!defaultPlatforms.includes(data.platform) && data.platform ? 'selected' : ''}>自定义</option>
      </select>
      <input type="text" name="id" placeholder="您的用户ID" value="${data.id || ''}">
      <input type="text" name="tags" placeholder="预设标签 (用逗号分隔)" value="${data.tags?.join(', ') || ''}">
      <button type="button" class="btn-remove">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    `;
    
    div.querySelector('.btn-remove').addEventListener('click', () => {
      div.remove();
      saveCurrentData();
    });
    
    div.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('change', saveCurrentData);
    });
    
    return div;
  }
  
  function saveCurrentData() {
    const items = lobsterList.querySelectorAll('.lobster-item');
    const lobsterCommunities = [];
    
    items.forEach(item => {
      const platform = item.querySelector('[name="platform"]').value;
      const id = item.querySelector('[name="id"]').value;
      const tagsInput = item.querySelector('[name="tags"]').value;
      const tags = tagsInput.split(',').map(t => t.trim()).filter(t => t);
      
      if (id) {
        lobsterCommunities.push({ platform, id, tags });
      }
    });
    
    const existing = loadDraft() || {};
    existing.lobsterCommunities = lobsterCommunities;
    saveDraft(existing);
  }
  
  // 加载草稿数据
  const draft = loadDraft();
  if (draft?.lobsterCommunities?.length > 0) {
    draft.lobsterCommunities.forEach(item => {
      lobsterList.appendChild(createLobsterItem(item));
    });
  } else {
    // 默认添加一项
    lobsterList.appendChild(createLobsterItem({ platform: '龙虾社区' }));
  }
  
  // 添加按钮
  addBtn.addEventListener('click', () => {
    lobsterList.appendChild(createLobsterItem());
  });
  
  // 表单提交
  document.getElementById('step-6-form').addEventListener('submit', (e) => {
    e.preventDefault();
    saveCurrentData();
    window.location.href = '/wizard/complete';
  });
</script>

<style>
  .wizard-page {
    min-height: 100vh;
    padding: 6rem 2rem 4rem;
  }
  
  .wizard-container {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .step-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .step-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .step-header p {
    color: var(--text-muted);
  }
  
  .step-form {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
  }
  
  .form-section {
    margin-bottom: 2rem;
  }
  
  .form-section:last-of-type {
    margin-bottom: 0;
  }
  
  .lobster-section {
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  
  .section-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  
  .form-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .section-desc {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
  }
  
  .lobster-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    text-align: left;
  }
  
  .lobster-item {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
  }
  
  .platform-select {
    width: 130px;
    padding: 0.625rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.875rem;
  }
  
  .lobster-item input {
    flex: 1;
    padding: 0.625rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.875rem;
  }
  
  .platform-select:focus,
  .lobster-item input:focus {
    outline: none;
    border-color: var(--accent);
  }
  
  .btn-remove {
    padding: 0.5rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 6px;
    color: #ef4444;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-remove:hover {
    background: rgba(239, 68, 68, 0.2);
  }
  
  .btn-add {
    width: 100%;
    padding: 0.875rem;
    background: var(--bg-tertiary);
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--text-secondary);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .btn-add:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .preview-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  
  .btn-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-secondary);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }
  
  .btn-preview:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
