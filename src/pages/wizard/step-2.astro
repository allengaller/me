---
import Layout from '../../layouts/Layout.astro';
import ProgressBar from '../../components/wizard/ProgressBar.astro';
import WizardNav from '../../components/wizard/WizardNav.astro';
---

<Layout>
  <main class="wizard-page">
    <div class="wizard-container">
      <ProgressBar currentStep={2} totalSteps={6} />
      
      <div class="step-header">
        <h1>Social Links</h1>
        <p>Add your social media and professional platform links.</p>
      </div>
      
      <form id="step-2-form" class="step-form">
        <div class="social-list" id="social-list">
          <!-- 动态生成社交链接项 -->
        </div>
        
        <button type="button" class="btn btn-add" id="add-social">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add social link
        </button>
        <button type="submit" style="display:none" id="submit-trigger"></button>
      </form>
      <WizardNav 
        prevUrl="/wizard/step-1" 
        nextUrl="/wizard/step-3" 
        nextText="Next" 
      />
    </div>
  </main>
</Layout>

<script>
  import { loadDraft, saveDraft } from '../../utils/storage.js';
  
  const socialList = document.getElementById('social-list');
  const addBtn = document.getElementById('add-social');
  
  const platformIcons = {
    'GitHub': '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>',
    'LinkedIn': '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
    'Twitter': '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
    'Email': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>',
    'Website': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>'
  };
  
  const defaultPlatforms = ['GitHub', 'LinkedIn', 'Twitter', 'Email', 'Website'];
  
  function createSocialItem(data = {}) {
    const div = document.createElement('div');
    div.className = 'social-item';
    div.innerHTML = `
      <div class="social-inputs">
        <select class="platform-select" name="platform">
          ${defaultPlatforms.map(p => `<option value="${p}" ${data.platform === p ? 'selected' : ''}>${p}</option>`).join('')}
          <option value="custom" ${!defaultPlatforms.includes(data.platform) && data.platform ? 'selected' : ''}>Custom</option>
        </select>
        <input type="url" name="url" placeholder="https://..." value="${data.url || ''}" required>
        <button type="button" class="btn-remove">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    `;
    
    div.querySelector('.btn-remove').addEventListener('click', () => {
      div.remove();
      saveCurrentData();
    });
    
    div.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('change', saveCurrentData);
    });
    
    return div;
  }
  
  function saveCurrentData() {
    const items = socialList.querySelectorAll('.social-item');
    const social = [];
    
    items.forEach(item => {
      const platform = item.querySelector('[name="platform"]').value;
      const url = item.querySelector('[name="url"]').value;
      
      if (url) {
        social.push({
          platform,
          url,
          icon: platformIcons[platform] || platformIcons.Website
        });
      }
    });
    
    const existing = loadDraft() || {};
    existing.social = social;
    saveDraft(existing);
  }
  
  // 加载草稿数据
  const draft = loadDraft();
  if (draft?.social?.length > 0) {
    draft.social.forEach(item => {
      socialList.appendChild(createSocialItem(item));
    });
  } else {
    // 默认添加一项
    socialList.appendChild(createSocialItem({ platform: 'GitHub' }));
  }
  
  // 添加按钮
  addBtn.addEventListener('click', () => {
    socialList.appendChild(createSocialItem());
  });
  
  // WizardNav next button
  document.querySelector('.wnav .btn-primary')?.addEventListener('click', () => {
    document.getElementById('step-2-form').requestSubmit();
  });

  // 表单提交
  document.getElementById('step-2-form').addEventListener('submit', (e) => {
    e.preventDefault();
    saveCurrentData();
    window.location.href = '/wizard/step-3';
  });
</script>

<style>
  .wizard-page {
    min-height: calc(100vh - 56px);
    padding: 3rem 2rem 4rem;
  }

  .wizard-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .step-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .step-header h1 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .step-header p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .step-form {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .social-item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }

  .social-inputs {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .platform-select {
    width: 120px;
    padding: 0.625rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.875rem;
  }

  .social-inputs input[type="url"] {
    flex: 1;
    padding: 0.625rem 1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.875rem;
  }

  .platform-select:focus,
  .social-inputs input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .btn-remove {
    background: transparent;
    border: 1px solid rgba(184, 76, 76, 0.15);
    color: var(--red);
    padding: 0.35rem;
    border-radius: 3px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-remove:hover {
    background: rgba(200, 100, 100, 0.1);
  }

  .btn-add {
    background: transparent;
    border: 1px dashed var(--border);
    color: var(--text-secondary);
    font-weight: 500;
    border-radius: var(--radius);
    padding: 0.7rem;
    font-size: 0.82rem;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 2rem;
    transition: color var(--transition), border-color var(--transition);
  }

  .btn-add:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }
</style>
