---
import Layout from '../../layouts/Layout.astro';
import ProgressBar from '../../components/wizard/ProgressBar.astro';
import WizardNav from '../../components/wizard/WizardNav.astro';
---

<Layout>
  <main class="wizard-page">
    <div class="wizard-container">
      <ProgressBar currentStep={5} totalSteps={6} />
      
      <div class="step-header">
        <h1>工作经历</h1>
        <p>记录您的职业发展历程</p>
      </div>
      
      <form id="step-5-form" class="step-form">
        <div class="experience-list" id="experience-list">
          <!-- 动态生成工作经历 -->
        </div>
        
        <button type="button" class="btn btn-add" id="add-experience">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          添加工作经历
        </button>
        
        <WizardNav 
          prevUrl="/wizard/step-4" 
          nextUrl="/wizard/step-6" 
          nextText="下一步" 
        />
      </form>
    </div>
  </main>
</Layout>

<script>
  import { loadDraft, saveDraft } from '../../utils/storage.js';
  
  const experienceList = document.getElementById('experience-list');
  const addBtn = document.getElementById('add-experience');
  
  function createExperienceItem(data = {}) {
    const div = document.createElement('div');
    div.className = 'experience-item';
    div.innerHTML = `
      <div class="exp-header">
        <input type="text" class="exp-title" name="title" placeholder="职位名称" value="${data.title || ''}" required>
        <span>@</span>
        <input type="text" class="exp-company" name="company" placeholder="公司名称" value="${data.company || ''}" required>
        <button type="button" class="btn-remove">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <input type="text" class="exp-period" name="period" placeholder="时间段 (例如: 2020 - 2023)" value="${data.period || ''}">
      <textarea class="exp-desc" name="description" placeholder="工作描述..." rows="2">${data.description || ''}</textarea>
      <div class="achievements-section">
        <label>主要成就</label>
        <div class="achievements-list"></div>
        <button type="button" class="btn-add-achievement">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          添加成就
        </button>
      </div>
    `;
    
    const achievementsList = div.querySelector('.achievements-list');
    const achievements = data.achievements || [];
    
    function addAchievement(text = '') {
      const aDiv = document.createElement('div');
      aDiv.className = 'achievement-item';
      aDiv.innerHTML = `
        <input type="text" placeholder="例如：主导团队完成核心项目" value="${text}">
        <button type="button" class="btn-remove-achievement">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      `;
      
      aDiv.querySelector('.btn-remove-achievement').addEventListener('click', () => {
        aDiv.remove();
      });
      
      achievementsList.appendChild(aDiv);
    }
    
    achievements.forEach(a => addAchievement(a));
    
    div.querySelector('.btn-add-achievement').addEventListener('click', () => {
      addAchievement();
    });
    
    div.querySelector('.btn-remove').addEventListener('click', () => {
      div.remove();
    });
    
    return div;
  }
  
  function saveCurrentData() {
    const items = experienceList.querySelectorAll('.experience-item');
    const experience = [];
    
    items.forEach(item => {
      const title = item.querySelector('[name="title"]').value;
      const company = item.querySelector('[name="company"]').value;
      const period = item.querySelector('[name="period"]').value;
      const description = item.querySelector('[name="description"]').value;
      
      const achievements = [];
      item.querySelectorAll('.achievement-item input').forEach(input => {
        if (input.value) achievements.push(input.value);
      });
      
      if (title && company) {
        experience.push({
          title,
          title_zh: title,
          company,
          company_zh: company,
          period,
          description,
          description_zh: description,
          achievements,
          achievements_zh: achievements
        });
      }
    });
    
    const existing = loadDraft() || {};
    existing.experience = experience;
    saveDraft(existing);
  }
  
  // 加载草稿数据
  const draft = loadDraft();
  if (draft?.experience?.length > 0) {
    draft.experience.forEach(item => {
      experienceList.appendChild(createExperienceItem(item));
    });
  } else {
    experienceList.appendChild(createExperienceItem());
  }
  
  // 添加按钮
  addBtn.addEventListener('click', () => {
    experienceList.appendChild(createExperienceItem());
  });
  
  // 表单提交
  document.getElementById('step-5-form').addEventListener('submit', (e) => {
    e.preventDefault();
    saveCurrentData();
    window.location.href = '/wizard/step-6';
  });
</script>

<style>
  .wizard-page {
    min-height: 100vh;
    padding: 6rem 2rem 4rem;
  }
  
  .wizard-container {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .step-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .step-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .step-header p {
    color: var(--text-muted);
  }
  
  .step-form {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
  }
  
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .experience-item {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }
  
  .exp-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  
  .exp-header span {
    color: var(--text-muted);
  }
  
  .exp-title {
    flex: 1;
    min-width: 120px;
    padding: 0.625rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }
  
  .exp-company {
    flex: 1;
    min-width: 120px;
    padding: 0.625rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }
  
  .exp-period {
    width: 100%;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  
  .exp-desc {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-family: inherit;
    resize: vertical;
    margin-bottom: 1rem;
  }
  
  .exp-title:focus,
  .exp-company:focus,
  .exp-period:focus,
  .exp-desc:focus {
    outline: none;
    border-color: var(--accent);
  }
  
  .btn-remove {
    padding: 0.5rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 6px;
    color: #ef4444;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-remove:hover {
    background: rgba(239, 68, 68, 0.2);
  }
  
  .achievements-section label {
    display: block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  
  .achievements-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  
  .achievement-item {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  
  .achievement-item input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 0.875rem;
  }
  
  .achievement-item input:focus {
    outline: none;
    border-color: var(--accent);
  }
  
  .btn-remove-achievement {
    padding: 0.375rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-remove-achievement:hover {
    color: #ef4444;
  }
  
  .btn-add-achievement {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg-secondary);
    border: 1px dashed var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .btn-add-achievement:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .btn-add {
    width: 100%;
    padding: 0.875rem;
    background: var(--bg-tertiary);
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--text-secondary);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  
  .btn-add:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
