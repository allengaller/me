---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="wiz-page">
    <div class="wiz-container">
      <div class="wiz-intro">
        <div class="wiz-tag">
          <span class="tag-line"></span>
          <span class="tag-text">6 steps</span>
        </div>
        <h1>Create your SOUL.md</h1>
        <p>A guided walkthrough to build a complete personal profile.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <span class="step-num">01</span>
          <h3>Basic Info</h3>
          <p>Name, title, location, bio</p>
        </div>
        <div class="step-card">
          <span class="step-num">02</span>
          <h3>Social Links</h3>
          <p>GitHub, LinkedIn, Twitter, etc.</p>
        </div>
        <div class="step-card">
          <span class="step-num">03</span>
          <h3>Skills</h3>
          <p>Expertise areas and tech stack</p>
        </div>
        <div class="step-card">
          <span class="step-num">04</span>
          <h3>Projects</h3>
          <p>Featured work and highlights</p>
        </div>
        <div class="step-card">
          <span class="step-num">05</span>
          <h3>Experience</h3>
          <p>Work history and achievements</p>
        </div>
        <div class="step-card">
          <span class="step-num">06</span>
          <h3>Community</h3>
          <p>Cross-platform integrations</p>
        </div>
      </div>

      <div class="start-section">
        <a href="/wizard/step-1" class="btn btn-primary btn-large">Start wizard</a>

        <div id="continue-section" class="continue-section" style="display: none;">
          <span class="divider-text">or</span>
          <button id="continue-btn" class="btn btn-secondary">
            Continue from last save
            <span class="timestamp"></span>
          </button>
        </div>
      </div>

      <div class="import-section">
        <p class="import-label">Quick start</p>
        <div class="import-options">
          <a href="/wizard/step-1?import=github" class="import-option">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <span>Import from GitHub</span>
          </a>
          <a href="/wizard/step-1?import=file" class="import-option">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>Import from file</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { hasDraft, getDraftTimestamp } from '../../utils/storage.js';

  if (hasDraft()) {
    const section = document.getElementById('continue-section');
    const btn = document.getElementById('continue-btn');
    const ts = getDraftTimestamp();
    if (section && ts) {
      const d = new Date(ts);
      const str = d.toLocaleString('zh-CN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      section.style.display = 'block';
      btn.querySelector('.timestamp').textContent = `(${str})`;
      btn.addEventListener('click', () => { window.location.href = '/wizard/step-1'; });
    }
  }
</script>

<style>
  .wiz-page {
    min-height: calc(100vh - 56px);
    padding: 4rem 2rem;
  }

  .wiz-container {
    max-width: 720px;
    margin: 0 auto;
  }

  .wiz-intro {
    text-align: center;
    margin-bottom: 3rem;
  }

  .wiz-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .tag-line {
    width: 20px;
    height: 1px;
    background: var(--accent);
  }

  .tag-text {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .wiz-intro h1 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }

  .wiz-intro p {
    font-size: 0.92rem;
    color: var(--text-secondary);
    font-weight: 300;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .step-card {
    background: var(--bg);
    padding: 1.5rem;
    transition: background 0.3s ease;
  }

  .step-card:hover {
    background: var(--bg-raised);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.75rem;
  }

  .step-card h3 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.3rem;
    letter-spacing: 0.01em;
  }

  .step-card p {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .start-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .continue-section { margin-top: 1rem; }

  .divider-text {
    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .timestamp {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .import-section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
    text-align: center;
  }

  .import-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .import-options {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .import-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-size: 0.8rem;
    text-decoration: none;
    transition: all var(--transition);
  }

  .import-option:hover {
    border-color: var(--border-accent);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
