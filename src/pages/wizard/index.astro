---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="wizard-page">
    <div class="wizard-container">
      <div class="wizard-intro">
        <div class="intro-icon">✨</div>
        <h1>创建您的个人档案</h1>
        <p>通过简单的 6 步引导，我们将帮助您创建完整的 SOUL.md 个人档案</p>
      </div>
      
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">📝</div>
          <h3>分步填写</h3>
          <p>按照引导逐步完善您的个人信息，每一步都有明确指引</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💾</div>
          <h3>自动保存</h3>
          <p>您的进度会自动保存在本地，随时可以回来继续</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🚀</div>
          <h3>一键导出</h3>
          <p>完成后可导出 SOUL.md、JSON、YAML 等多种格式</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🦞</div>
          <h3>社区集成</h3>
          <p>支持在龙虾社区等平台快速导入您的预设信息</p>
        </div>
      </div>
      
      <div class="start-section">
        <a href="/wizard/step-1" class="btn btn-primary btn-large">
          开始创建
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
        
        <div id="continue-section" class="continue-section" style="display: none;">
          <span class="divider">或者</span>
          <button id="continue-btn" class="btn btn-secondary">
            继续上次进度
            <span class="timestamp"></span>
          </button>
        </div>
      </div>
      
      <div class="import-section">
        <h3>快速开始</h3>
        <p>已有资料？选择一种方式快速导入：</p>
        <div class="import-options">
          <a href="/wizard/step-1?import=github" class="import-option">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>从 GitHub 导入</span>
          </a>
          <a href="/wizard/step-1?import=file" class="import-option">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>从文件导入</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { hasDraft, getDraftTimestamp } from '../../utils/storage.js';
  
  // 检查是否有草稿
  if (hasDraft()) {
    const continueSection = document.getElementById('continue-section');
    const continueBtn = document.getElementById('continue-btn');
    const timestamp = getDraftTimestamp();
    
    if (continueSection && timestamp) {
      const date = new Date(timestamp);
      const timeStr = date.toLocaleString('zh-CN', {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
      
      continueSection.style.display = 'block';
      continueBtn.querySelector('.timestamp').textContent = `(${timeStr})`;
      
      continueBtn.addEventListener('click', () => {
        window.location.href = '/wizard/step-1';
      });
    }
  }
</script>

<style>
  .wizard-page {
    min-height: 100vh;
    padding: 6rem 2rem 4rem;
  }
  
  .wizard-container {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .wizard-intro {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .intro-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }
  
  .wizard-intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }
  
  .wizard-intro p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  
  .feature-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
  }
  
  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }
  
  .feature-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  
  .feature-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .feature-card p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  
  .start-section {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }
  
  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.125rem;
  }
  
  .btn-primary {
    background: var(--accent);
    color: white;
    box-shadow: 0 4px 16px var(--accent-glow);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }
  
  .btn-secondary {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  
  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .continue-section {
    margin-top: 1.5rem;
  }
  
  .divider {
    display: block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  
  .timestamp {
    font-size: 0.75rem;
    opacity: 0.8;
  }
  
  .import-section {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
  }
  
  .import-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  
  .import-section > p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  
  .import-options {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .import-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .import-option:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
  
  .import-option svg {
    opacity: 0.8;
  }
</style>
