  function generateMarkdown() {
    const identity = a(0);
    const name = identity.split(/[,.\uff0c\u3002]/)[0].trim() || 'Your Name';
    const now = new Date().toISOString().split('T')[0];

    const L = [];
    L.push(`# ${name} -- \u9760\u8C31\u4E2A\u4EBA\u4E3B\u9875`);
