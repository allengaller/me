    return L.join('\n');
  }

  function openExport() {
    const content = exportTab === 'html' ? generateHTML() : generateMarkdown();
    $exportArea.value = content;
    $modalWarn.style.display = answeredCount() === 0 ? 'block' : 'none';
    $exportModal.style.display = 'flex';
  }

  function updateExportContent() {
    const content = exportTab === 'html' ? generateHTML() : generateMarkdown();
    $exportArea.value = content;
  }

  $('exportBtn').addEventListener('click', openExport);
  $modalBackdrop.addEventListener('click', () => { $exportModal.style.display = 'none'; });
  $modalClose.addEventListener('click', () => { $exportModal.style.display = 'none'; });

  document.querySelectorAll('.rl-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.rl-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      exportTab = tab.dataset.tab;
      updateExportContent();
    });
  });

  $copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText($exportArea.value).then(() => {
      $copyBtn.textContent = 'Copied!'; setTimeout(() => { $copyBtn.textContent = 'Copy to clipboard'; }, 2000);
    });
  });
  $downloadBtn.addEventListener('click', () => {
    const ext = exportTab === 'html' ? 'html' : 'md';
    const b = new Blob([$exportArea.value], { type: 'text/plain' });
    const u = URL.createObjectURL(b);
    const a = document.createElement('a'); a.href = u; a.download = `reliable-homepage.${ext}`; a.click();
    URL.revokeObjectURL(u);
  });

  $('resetBtn').addEventListener('click', () => { $resetModal.style.display = 'flex'; });
  $resetBackdrop.addEventListener('click', () => { $resetModal.style.display = 'none'; });
  $resetClose.addEventListener('click', () => { $resetModal.style.display = 'none'; });
  $resetCancel.addEventListener('click', () => { $resetModal.style.display = 'none'; });
  $resetConfirm.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    current = 0;
    answers = {};
    $resetModal.style.display = 'none';
    renderQuestion();
  });

  loadState();
  if (current >= QUESTIONS.length) current = 0;
  renderQuestion();
