    }

    if (has(2)) { L.push('## \u{1F4AC} \u53E3\u7891 (Reputation)'); L.push(''); L.push(a(2)); L.push(''); }
    if (has(16)) { L.push('## \u{1F4A1} \u5FAE\u5BFA\u4ED6\u4EBA (Mentorship)'); L.push(''); L.push(a(16)); L.push(''); }
    if (has(17)) { L.push('## \u{2728} \u4EBA\u751F\u8F68\u8FF9 (Trajectory)'); L.push(''); L.push(a(17)); L.push(''); }

