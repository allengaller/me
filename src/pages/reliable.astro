    const psyStress = a(7);
    const psyDecision = a(8);
    const mgmtDelivery = a(9);
    const mgmtComm = a(10);
    const mgmtMentor = a(11);
    const evStory = a(12);
    const evHard = a(13);
    const evLong = a(14);
    const philosophy = a(15);
    const advice = a(16);
    const trajectory = a(17);

    return `<!DOCTYPE html>
