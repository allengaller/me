---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="rl-page" id="app">
    <div class="rl-page-header">
      <p class="rl-eyebrow">Reliable Mode / 靠谱模式</p>
      <h1 class="rl-title">Build your <em>reliable</em> identity.</h1>
      <p class="rl-desc">18 questions across 6 dimensions -- sociology, psychology, management, and beyond. Generate a personal homepage that radiates trustworthiness.</p>
    </div>

    <div class="rl-split">
      <aside class="rl-preview-col" id="previewCol">
        <div class="rl-preview-top">
          <span class="rl-preview-label">Homepage Preview</span>
          <div class="rl-preview-actions">
            <button class="rl-btn-icon" id="resetBtn" title="Start over">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            </button>
            <button class="rl-btn-icon" id="exportBtn" title="Export">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </button>
          </div>
        </div>
        <div class="rl-preview-scroll" id="previewContent">
          <div class="rl-preview-empty">Your reliable personal homepage will take shape here...</div>
        </div>
      </aside>

      <main class="rl-qa-col">
        <div class="rl-progress">
          <div class="rl-progress-bar">
            <div class="rl-progress-fill" id="progressFill"></div>
          </div>
          <span class="rl-progress-text" id="progressText">1 / 18</span>
        </div>

        <div class="rl-qa-body">
          <div class="rl-chapter" id="qaChapter"></div>
          <h2 class="rl-question" id="qaQuestion"></h2>
          <p class="rl-hint" id="qaHint"></p>
          <textarea class="rl-input" id="qaInput" rows="5" placeholder=""></textarea>
          <p class="rl-shortcut" id="qaShortcut"></p>
        </div>

        <div class="rl-nav">
          <button class="btn btn-secondary" id="prevBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Previous
          </button>
          <button class="btn btn-primary" id="nextBtn">
            Next
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </main>
    </div>

    <div class="rl-modal" id="exportModal" style="display:none;">
      <div class="rl-modal-backdrop" id="modalBackdrop"></div>
      <div class="rl-modal-body">
        <div class="rl-modal-header">
          <h3>Export Personal Homepage</h3>
          <button class="rl-btn-icon" id="modalClose">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="rl-modal-tabs">
          <button class="rl-tab active" data-tab="html">HTML Homepage</button>
          <button class="rl-tab" data-tab="md">Markdown</button>
        </div>
        <div class="rl-modal-warn" id="modalWarn" style="display:none;">
          You have not answered any questions yet. The export will be mostly empty.
        </div>
        <textarea class="rl-modal-area" id="exportArea" readonly rows="20"></textarea>
        <div class="rl-modal-actions">
          <button class="btn btn-primary" id="copyBtn">Copy to clipboard</button>
          <button class="btn btn-secondary" id="downloadBtn">Download</button>
        </div>
      </div>
    </div>

    <div class="rl-modal" id="resetModal" style="display:none;">
      <div class="rl-modal-backdrop" id="resetBackdrop"></div>
      <div class="rl-modal-body" style="max-width:440px;">
        <div class="rl-modal-header">
          <h3>Start over?</h3>
          <button class="rl-btn-icon" id="resetClose">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="rl-modal-prompt">
          This will clear all your answers and progress. This cannot be undone.
        </div>
        <div class="rl-modal-actions">
          <button class="btn btn-secondary" id="resetCancel">Cancel</button>
          <button class="btn btn-danger" id="resetConfirm">Clear everything</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import '../scripts/reliable-engine';
</script>

<style>
  .rl-page { min-height: calc(100vh - 56px); }

  .rl-page-header {
    text-align: center;
    padding: 2.5rem 2rem 0;
    max-width: 580px;
    margin: 0 auto;
  }

  .rl-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .rl-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .rl-title em { color: var(--accent); }

  .rl-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .rl-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 56px - 180px);
    border-top: 1px solid var(--border-subtle);
  }

  .rl-preview-col {
    background: var(--bg-raised);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .rl-preview-top {
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rl-preview-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .rl-preview-actions { display: flex; gap: 0.5rem; }

  .rl-btn-icon {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    transition: color var(--transition);
    display: flex;
  }
  .rl-btn-icon:hover { color: var(--text); }

  .rl-preview-scroll {
    flex: 1;
    padding: 2rem 1.5rem;
    overflow-y: auto;
  }

  .rl-preview-empty {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .pv-hero {
    text-align: center;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .pv-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .pv-tagline {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .pv-philosophy {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--accent);
    font-style: italic;
    line-height: 1.6;
  }

  .pv-chapter {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .pv-chapter:first-child { margin-top: 0; }

  .pv-paragraph {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }

  .rl-qa-col {
    display: flex;
    flex-direction: column;
    padding: 2rem 3rem;
  }

  .rl-progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .rl-progress-bar {
    flex: 1;
    height: 2px;
    background: var(--border);
    border-radius: 1px;
  }

  .rl-progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 1px;
    transition: width 0.4s ease;
  }

  .rl-progress-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .rl-qa-body { flex: 1; }

  .rl-chapter {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .rl-question {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .rl-hint {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .rl-input {
    width: 100%;
    min-height: 140px;
    font-size: 0.92rem;
    line-height: 1.7;
    resize: vertical;
    padding: 0.9rem 1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    transition: border-color var(--transition);
    outline: none;
  }
  .rl-input:focus { border-color: var(--accent-border); }
  .rl-input::placeholder { color: var(--text-muted); font-style: italic; }

  .rl-shortcut {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    opacity: 0.7;
  }

  .rl-nav {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    margin-top: auto;
  }

  .rl-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rl-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
  }

  .rl-modal-body {
    position: relative;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    width: 90%;
    max-width: 680px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .rl-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .rl-modal-header h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .rl-modal-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
  }

  .rl-tab {
    flex: 1;
    padding: 0.6rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all var(--transition);
  }
  .rl-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .rl-tab:hover { color: var(--text-secondary); }

  .rl-modal-warn {
    padding: 0.75rem 1.5rem;
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--accent-dim);
    border-bottom: 1px solid var(--border-subtle);
  }

  .rl-modal-area {
    flex: 1;
    padding: 1.5rem;
    background: var(--bg);
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    resize: none;
    outline: none;
  }

  .rl-modal-prompt {
    padding: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .rl-modal-actions {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .btn-danger {
    background: var(--red);
    color: #fff;
  }
  .btn-danger:hover { opacity: 0.9; color: #fff; }

  @media (max-width: 768px) {
    .rl-split {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .rl-preview-col {
      border-right: none;
      border-bottom: 1px solid var(--border);
      max-height: 35vh;
    }
    .rl-qa-col { padding: 1.5rem; }
    .rl-question { font-size: 1.1rem; }
  }
</style>
