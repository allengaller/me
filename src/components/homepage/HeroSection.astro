---
import Avatar from '../ui/Avatar.astro';
import Button from '../ui/Button.astro';

interface Props {
  name: string;
  title: string;
  location?: string;
  about?: string;
  avatar?: string;
}

const { name, title, location, about, avatar } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <h1 class="hero-name">{name}</h1>
      <p class="hero-title">{title}</p>
      {location && (
        <div class="hero-location">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{location}</span>
        </div>
      )}
      {about && <p class="hero-about">{about}</p>}
      <div class="hero-actions">
        <Button href="/wizard" variant="primary" size="lg">Get Started</Button>
        <Button href="/resume" variant="secondary" size="lg">View Resume</Button>
      </div>
    </div>
    <div class="hero-visual">
      <Avatar src={avatar} name={name} size="xl" />
      <div class="skill-tree-preview">
        <div class="tree-label">Skills</div>
        <div class="tree-branches">
          <span class="branch">Frontend</span>
          <span class="branch">Backend</span>
          <span class="branch">DevOps</span>
        </div>
        <div class="tree-bar">
          <span class="bar-fill"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    padding: 4rem 2rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    width: 100%;
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    animation: fade-up 0.6s var(--ease-out) forwards;
  }

  .hero-title {
    font-size: 1.25rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1rem;
    animation: fade-up 0.6s var(--ease-out) 0.1s forwards;
    opacity: 0;
  }

  .hero-location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    animation: fade-up 0.6s var(--ease-out) 0.2s forwards;
    opacity: 0;
  }

  .hero-about {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 500px;
    margin-bottom: 2rem;
    animation: fade-up 0.6s var(--ease-out) 0.3s forwards;
    opacity: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: fade-up 0.6s var(--ease-out) 0.4s forwards;
    opacity: 0;
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    animation: fade-up 0.6s var(--ease-out) 0.5s forwards;
    opacity: 0;
  }

  .skill-tree-preview {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    width: 240px;
  }

  .tree-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .tree-branches {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .branch {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .tree-bar {
    height: 3px;
    background: var(--bg-overlay);
    border-radius: 2px;
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    width: 75%;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-hover) 100%);
    border-radius: 2px;
    animation: bar-grow 1.5s var(--ease-out) forwards;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1.5rem;
    }

    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
    }

    .hero-about {
      max-width: none;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      flex-direction: row;
      gap: 1.5rem;
    }
  }
</style>