---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'url' | 'textarea' | 'select';
  placeholder?: string;
  value?: string;
  required?: boolean;
  options?: string[];
  rows?: number;
  hint?: string;
}

const {
  label,
  name,
  type = 'text',
  placeholder = '',
  value = '',
  required = false,
  options = [],
  rows = 4,
  hint = ''
} = Astro.props;
---

<div class="ff">
  <label for={name}>
    {label}
    {required && <span class="ff-req">*</span>}
  </label>

  {type === 'textarea' ? (
    <textarea
      id={name}
      name={name}
      placeholder={placeholder}
      rows={rows}
      required={required}
    >{value}</textarea>
  ) : type === 'select' ? (
    <select id={name} name={name} required={required}>
      <option value="">Select...</option>
      {options.map(opt => (
        <option value={opt} selected={value === opt}>{opt}</option>
      ))}
    </select>
  ) : (
    <input
      type={type}
      id={name}
      name={name}
      placeholder={placeholder}
      value={value}
      required={required}
    />
  )}

  {hint && <span class="ff-hint">{hint}</span>}
</div>

<style>
  .ff {
    margin-bottom: 1.25rem;
  }

  .ff label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 500;
    color: var(--text-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .ff-req {
    color: var(--red);
    margin-left: 0.15rem;
  }

  .ff-hint {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
