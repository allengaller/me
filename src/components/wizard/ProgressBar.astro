---
interface Props {
  currentStep: number;
  totalSteps: number;
}

const { currentStep, totalSteps } = Astro.props;
const steps = ['Basic Info', 'Social', 'Skills', 'Projects', 'Experience', 'Community'];
---

<div class="pb-wrap">
  <div class="pb-steps">
    {steps.map((step, index) => {
      const stepNum = index + 1;
      const isActive = stepNum === currentStep;
      const isCompleted = stepNum < currentStep;

      return (
        <div class={`pb-step ${isActive ? 'active' : ''} ${isCompleted ? 'done' : ''}`}>
          <div class="pb-dot">
            {isCompleted ? (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            ) : (
              <span>{stepNum}</span>
            )}
          </div>
          <span class="pb-label">{step}</span>
          {index < steps.length - 1 && <div class="pb-line" />}
        </div>
      );
    })}
  </div>
  <div class="pb-count">
    Step {currentStep} / {totalSteps}
  </div>
</div>

<style>
  .pb-wrap {
    margin-bottom: 2.5rem;
  }

  .pb-steps {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    max-width: 700px;
    margin: 0 auto;
  }

  .pb-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    position: relative;
  }

  .pb-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.65rem;
    color: var(--text-muted);
    transition: all 0.3s ease;
    z-index: 1;
  }

  .pb-step.active .pb-dot {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .pb-step.done .pb-dot {
    background: var(--bg-overlay);
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .pb-label {
    margin-top: 0.4rem;
    font-size: 0.6rem;
    color: var(--text-muted);
    text-align: center;
    transition: color 0.3s ease;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .pb-step.active .pb-label {
    color: var(--text-secondary);
  }

  .pb-step.done .pb-label {
    color: var(--text-muted);
  }

  .pb-line {
    position: absolute;
    top: 14px;
    left: 50%;
    width: 100%;
    height: 1px;
    background: var(--border);
    z-index: 0;
  }

  .pb-step.done .pb-line {
    background: var(--accent-border);
  }

  .pb-count {
    text-align: center;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  @media (max-width: 768px) {
    .pb-label { display: none; }
    .pb-steps { padding: 0 0.5rem; }
  }
</style>
