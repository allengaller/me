---

<div class="github-import">
  <div class="import-header">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
    </svg>
    <div>
      <h3>从 GitHub 导入</h3>
      <p>自动获取您的 GitHub 公开资料、仓库和语言统计</p>
    </div>
  </div>
  
  <div class="import-form">
    <div class="input-group">
      <span class="input-prefix">@</span>
      <input 
        type="text" 
        id="github-username" 
        placeholder="GitHub 用户名"
        class="github-input"
      />
      <button id="github-import-btn" class="import-btn">
        <span class="btn-text">导入</span>
        <span class="btn-loading" style="display: none;">
          <svg class="spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="10"></circle>
          </svg>
        </span>
      </button>
    </div>
    <span class="import-hint">输入您的 GitHub 用户名，我们将自动获取您的公开资料</span>
  </div>
  
  <div id="github-import-result" class="import-result" style="display: none;"></div>
</div>

<script>
  import { importFromGitHub } from '../../utils/importers/github';
  import { saveDraft } from '../../utils/storage';
  
  const usernameInput = document.getElementById('github-username');
  const importBtn = document.getElementById('github-import-btn');
  const resultDiv = document.getElementById('github-import-result');
  const btnText = importBtn.querySelector('.btn-text');
  const btnLoading = importBtn.querySelector('.btn-loading');
  
  async function handleImport() {
    const username = usernameInput.value.trim();
    if (!username) {
      showResult('请输入 GitHub 用户名', 'error');
      return;
    }
    
    setLoading(true);
    
    try {
      const data = await importFromGitHub(username);
      
      // 合并到现有数据
      const existing = JSON.parse(localStorage.getItem('me_wizard_draft') || '{}');
      const merged = {
        ...existing,
        data: {
          ...existing.data,
          ...data
        }
      };
      
      saveDraft(merged.data);
      
      showResult(`
        <strong>导入成功!</strong><br>
        已获取: ${data.profile.name}<br>
        项目数: ${data.projects.length} | 技能数: ${data.skills.length}
      `, 'success');
      
      // 触发事件通知其他组件
      window.dispatchEvent(new CustomEvent('profile-updated', { detail: data }));
      
    } catch (error) {
      showResult(`导入失败: ${error.message}`, 'error');
    } finally {
      setLoading(false);
    }
  }
  
  function setLoading(loading) {
    importBtn.disabled = loading;
    btnText.style.display = loading ? 'none' : 'inline';
    btnLoading.style.display = loading ? 'inline' : 'none';
  }
  
  function showResult(message, type) {
    resultDiv.innerHTML = message;
    resultDiv.className = `import-result ${type}`;
    resultDiv.style.display = 'block';
  }
  
  importBtn.addEventListener('click', handleImport);
  usernameInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleImport();
  });
</script>

<style>
  .github-import {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
  }
  
  .import-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .import-header svg {
    color: var(--text-primary);
  }
  
  .import-header h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  
  .import-header p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0 0;
  }
  
  .import-form {
    margin-bottom: 1rem;
  }
  
  .input-group {
    display: flex;
    align-items: stretch;
    gap: 0;
  }
  
  .input-prefix {
    display: flex;
    align-items: center;
    padding: 0 0.75rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-right: none;
    border-radius: 10px 0 0 10px;
    color: var(--text-muted);
    font-weight: 600;
  }
  
  .github-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 0;
    color: var(--text-primary);
    font-size: 1rem;
  }
  
  .github-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  
  .import-btn {
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0 10px 10px 0;
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .import-btn:hover:not(:disabled) {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }
  
  .import-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  
  .spinner {
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  .import-hint {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  
  .import-result {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  
  .import-result.success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22c55e;
  }
  
  .import-result.error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }
</style>
