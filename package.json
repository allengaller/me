{
  "name": "me",
  "type": "module",
  "version": "1.0.0",
  "description": "ME - 个人档案生成器。通过友好的分步引导创建 SOUL.md 个人档案",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:core": "cd packages/core && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'packages/core/src/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,js,json}' 'scripts/**/*.ts' 'packages/core/src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "update:profile": "tsx scripts/update-profile.ts",
    "add:project": "tsx scripts/add-project.ts",
    "validate": "tsx scripts/validate.ts",
    "skills": "tsx scripts/skills.ts"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "vitest": "^4.1.6"
  }
}
